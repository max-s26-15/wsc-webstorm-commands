{
  "name": "webstorm-commands",
  "version": "0.1.0",
  "description": "Launch a set of WebStorm run configurations at once, each in its own Run/Debug or Terminal tab, over the IDE's MCP Server",
  "keywords": [
    "webstorm",
    "jetbrains",
    "mcp",
    "run-configurations",
    "cli"
  ],
  "license": "MIT",
  "author": "Max Soltys",
  "homepage": "https://github.com/max-s26-15/wsc-webstorm-commands#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/max-s26-15/wsc-webstorm-commands.git"
  },
  "bugs": {
    "url": "https://github.com/max-s26-15/wsc-webstorm-commands/issues"
  },
  "type": "module",
  "bin": {
    "wsc": "./bin/wsc.js",
    "wsc-mcp-probe": "./scripts/mcp-probe.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/mcp-probe.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test:coverage": "node --test --experimental-test-coverage",
    "mcp:probe": "node scripts/mcp-probe.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
